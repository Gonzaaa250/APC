@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesion";
}

@* Nuevo Login *@
@section Css {
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login&register.css">
}
<div class="main">
    <div class="container a-container" id="a-container">
        <form class="form" id="a-form" method="" action="">
            <h2 class="form_title title">Crea un usuario</h2>
            <div class="form__icons"><img class="form__icon">
                <img class="form__icon" />
                <img class="form__icon" />
            </div>
            <span class="form__span">Usa tu email para registrarte</span>
            <input class="form__input" type="text" placeholder="Email" id="regemail">
            <input class="form__input" type="password" placeholder="Contraseña" id="regpass">
            <input class="form__input" type="password" placeholder="Validar contraseña" id="regrtpass">
            <button class="form__button button submit" id="btn-register">Registrarse</button>
        </form>
    </div>
    <div class="container b-container" id="b-container">
        <form class="form" id="b-form" method="" action="">
            <h2 class="form_title title">Inicia sesion</h2>
            <div class="form__icons">
                <img class="form__icon" alt="" />
                <img class="form__icon" alt="" />
                <img class="form__icon" alt="" />
            </div>
            <span class="form__span">Usa tu email para iniciar sesion</span>
            <input class="form__input" type="text" placeholder="Email" id="logemail">
            <input class="form__input" type="password" placeholder="Contraseña" id="logpass">
            <a class="form__link">¿Olvidaste tu contraseña?</a>
            <button class="form__button button submit" onclick="IniciarSesion()">Inicia sesion</button>
        </form>
    </div>
    <div class="switch" id="switch-cnt">
        <div class="switch__circle"></div>
        <div class="switch__circle switch__circle--t"></div>
        <div class="switch__container" id="switch-c1">
            <h2 class="switch__title title">Bienvenido!</h2>
            <p class="switch__description description">Si ya tenes cuenta, inicia sesion con tu informacion personal
            </p>
            <button class="switch__button button switch-btn">Inicia sesion</button>
        </div>
        <div class="switch__container is-hidden" id="switch-c2">
            <h2 class="switch__title title">Hola amigo!</h2>
            <p class="switch__description description">Registrate para acceder a toda la informacion de APC Padel</p>
            <button class="switch__button button switch-btn">Registrarse</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/AnimacionLogin_Registes.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Login_Register.js"></script>
}